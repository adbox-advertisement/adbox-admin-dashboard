# Copy to .env.local, uncomment one option, then restart Vite.
#
# Default (both commented): `npm run dev` proxies /api to a backend on http://localhost:3005.

# Develop against the live API: Vite proxies /api there from your machine, so the API's CORS
# setting doesn't apply. Leave VITE_SUPER_ADMIN_API_URL unset for this.
# ADBOX_API_PROXY_TARGET=https://admin-api.adboxgh.com

# Call an API straight from the browser (production builds such as Vercel). The API must allow
# this site's origin in SUPER_ADMIN_CORS_ORIGIN.
# VITE_SUPER_ADMIN_API_URL=https://admin-api.adboxgh.com/api/v1
